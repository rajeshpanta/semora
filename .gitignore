# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# supabase cli cache
supabase/.temp/

# Local-only infra/account notes — never commit (account emails are phishing targets)
*.local.md

# Downloaded OAuth/client secret files — never commit
client_secret*.json
*.local.json
secrets.local/

# Regenerable upload bundle — the PNGs it contains are already tracked.
screenshots/store-screenshots/*.zip
# Ad-hoc screenshots dropped in the repo root.
/Screenshot *.png

# ── secrets/ ────────────────────────────────────────────────
# This repo is PUBLIC. Everything under secrets/ is ignored by default and only
# the encrypted bundle is allowed through, so a stray plaintext key dropped in
# here can never be committed by accident. scripts/secrets-seal.sh uses `git
# add -f` on exactly the one permitted file.
secrets/*
!secrets/README.md
!secrets/semora-secrets.tar.gz.gpg

# Never, under any circumstances, in a public repo.
*.p8
*.p12
*.mobileprovision
client_secret*.json
.vercel
.env*
