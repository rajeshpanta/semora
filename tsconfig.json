{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Overriding "exclude" replaces the expo/tsconfig.base list, so the base
  // entries are replicated here. supabase/functions is added because edge
  // functions run on Deno (Deno globals, https:/npm: imports) and are
  // typechecked/deployed by the Supabase CLI, not by this app's tsc.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "website",
    "supabase/functions",
    // Deno test files. Same reason as supabase/functions: these run under Deno
    // (Deno globals, https: imports, explicit .ts extensions), not under the
    // app's bundler. `~/.deno/bin/deno test --no-lock --unstable-sloppy-imports
    // lib/termMatch.test.ts` typechecks and runs them.
    "lib/**/*.test.ts"
  ]
}
